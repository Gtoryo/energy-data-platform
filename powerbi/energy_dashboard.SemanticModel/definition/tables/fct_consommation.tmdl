table fct_consommation
	lineageTag: 915af9fb-1fa5-41a5-bdd5-03f2f18adbca

	measure 'Énergie consommée (TWh)' =
			
			SUM(fct_consommation[consommation_mwh]) / 1000000
		formatString: 0.00
		lineageTag: 42c4f2cf-fc76-4f2c-a23e-3fef855850db

	measure 'Durée mesurée (h)' =
			
			SUM(fct_consommation[duree_h])
		formatString: #,0
		lineageTag: 477232fe-2822-40a9-ab9a-8a133d5b9950

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Puissance moyenne (MW)' =
			
			DIVIDE(SUM(fct_consommation[consommation_mwh]), [Durée mesurée (h)])
		formatString: #,0
		lineageTag: 6f2f5b1d-3c2f-4db7-aeef-034bc45fa11c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Puissance maximale (MW)' =
			
			MAX(fct_consommation[consommation_mw])
		formatString: #,0
		lineageTag: 0feb7046-6c86-418e-9776-69886eb5b320

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Puissance minimale (MW)' =
			
			MIN(fct_consommation[consommation_mw])
		formatString: #,0
		lineageTag: 3cd2a1ee-4ec7-43e1-902a-271bafda968f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Intensité carbone (g/kWh)' =
			
			DIVIDE(
			    SUMX(
			        fct_consommation,
			        fct_consommation[taux_co2_g_par_kwh] * fct_consommation[duree_h]
			    ),
			    [Durée mesurée (h)]
			)
		formatString: 0.0
		lineageTag: 748d0805-5f45-4476-bae8-bda0953e230e

	measure 'Prévision J-1 (MW)' =
			
			DIVIDE(
			    SUMX(
			        fct_consommation,
			        fct_consommation[prevision_j1_mw] * fct_consommation[duree_h]
			    ),
			    [Durée mesurée (h)]
			)
		formatString: #,0
		lineageTag: 96c66721-eafb-4cfc-b400-d18c30860bc1

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Écart absolu J-1 (MW)' =
			
			DIVIDE(
			    SUMX(
			        fct_consommation,
			        ABS(fct_consommation[prevision_j1_mw] - fct_consommation[consommation_mw])
			            * fct_consommation[duree_h]
			    ),
			    [Durée mesurée (h)]
			)
		formatString: #,0
		lineageTag: 49c8ce91-fecc-495a-94c8-76371def0490

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Écart relatif J-1' =
			
			DIVIDE([Écart absolu J-1 (MW)], [Puissance moyenne (MW)])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 666c4e98-02bb-43f5-802d-1e2762b76b88


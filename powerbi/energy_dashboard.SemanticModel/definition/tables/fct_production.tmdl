table fct_production
	lineageTag: 8fc3b525-2c5c-4f91-90ae-2e940760d9ff

	measure 'Production (TWh)' =
			
			SUM(fct_production[production_mwh]) / 1000000
		formatString: 0.00
		lineageTag: 125efd5d-1b53-49ce-aaac-fc8e71275cea

	measure 'Production toutes filières (TWh)' =
			
			CALCULATE([Production (TWh)], REMOVEFILTERS(dim_filiere))
		formatString: 0.00
		lineageTag: ed1a6469-b6eb-4031-ab1e-13d784485631

	measure 'Part du nucléaire' =
			
			DIVIDE(
			    CALCULATE(
			        [Production (TWh)],
			        REMOVEFILTERS(dim_filiere),
			        dim_filiere[filiere] = "nucleaire"
			    ),
			    [Production toutes filières (TWh)]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 97468bca-751c-4448-8f00-98a4af7cd766

	measure 'Part des renouvelables' =
			
			DIVIDE(
			    CALCULATE(
			        [Production (TWh)],
			        REMOVEFILTERS(dim_filiere),
			        dim_filiere[est_renouvelable] = TRUE()
			    ),
			    [Production toutes filières (TWh)]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6abb71fd-dc96-4dbb-8814-2d500d5ab50c

